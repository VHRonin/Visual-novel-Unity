    - rid: 7997109353198911555
      type: {class: SayEvent, ns: , asm: Assembly-CSharp}
      data:
        character: 1
        text: "\u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u043A\u0443\u0434\u0430
          \u0436\u0435?"
        emotion: 0
    - rid: 7997109353198911556
      type: {class: SayEvent, ns: , asm: Assembly-CSharp}
      data:
        character: 1
        text: "\u0421\u0438\u0433\u0443\u0440\u0434 \u0425\u0435\u043B\u044C\u043C\u0438\u0440.
          \u041F\u0440\u0438\u0441\u0430\u0436\u0438\u0432\u0430\u0439\u0441\u044F,
          \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440 \u0431\u0443\u0434\u0435\u0442
          \u0434\u043E\u043B\u0433\u0438\u043C."
        emotion: 0
    - rid: 7997109378020278337
      type: {class: SayEvent, ns: , asm: Assembly-CSharp}
      data:
        character: 1
        text: "\u0425\u0432\u0430\u0442\u043A\u0430 \u043C\u0443\u0436\u0447\u0438\u043D\u044B
          \u0431\u044B\u043B\u0430 \u0436\u0435\u043B\u0435\u0437\u043D\u043E\u0439."
        emotion: 0
    - rid: 7997109378020278349
      type: {class: SayEvent, ns: , asm: Assembly-CSharp}
      data:
        character: 0
        text: "\u0417\u0430\u043A\u0430\u0437 \u043D\u0430 \u043C\u043E\u043D\u0441\u0442\u0440\u043E\u0432.
          \u041E\u043D\u0438 \u0441\u043A\u043E\u0440\u043E \u043F\u043E\u044F\u0432\u044F\u0442\u0441\u044F,
          \u0442\u0430\u043A \u0447\u0442\u043E \u0431\u0443\u0434\u044C \u0434\u043E\u0431\u0440,
          \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438."
        emotion: 0
    - rid: 7997109378020278350
      type: {class: SayEvent, ns: , asm: Assembly-CSharp}
      data:
        character: 1
        text: "\u041F\u043E\u043B\u0433\u043E\u0434\u0430 \u043D\u0430\u0437\u0430\u0434
          \u0442\u0435\u0442\u0440\u0430\u0434\u043A\u0438 \u0443\u0447\u0438\u043B\u0430,
          \u0430 \u0441\u0435\u0439\u0447\u0430\u0441 \u043D\u0430 \u043C\u043E\u043D\u0441\u0442\u0440\u043E\u0432
          \u043E\u0445\u043E\u0442\u0438\u0448\u044C\u0441\u044F. \u0425\u0430."
        emotion: 0
    - rid: 7997109378020278351
      type: {class: SayEvent, ns: , asm: Assembly-CSharp}
      data:
        character: 1
        text: "\u0422\u044B \u0431\u044B\u0441\u0442\u0440\u043E \u0443\u0447\u0438\u0448\u044C\u0441\u044F,
          \u043A\u043E\u0442\u0451\u043D\u043E\u043A."
        emotion: 0
    - rid: 7997109378020278352
      type: {class: SayEvent, ns: , asm: Assembly-CSharp}
      data:
        character: 0
        text: "\u0414\u0430 \u043A\u0442\u043E... \u041A\u0442\u043E \u0442\u044B
          \u0442\u0430\u043A\u043E\u0439?"
        emotion: 0
    - rid: 7997109378020278354
      type: {class: SayEvent, ns: , asm: Assembly-CSharp}
      data:
        character: 1
        text: "\u0421\u0438\u0433\u0443\u0440\u0434 \u0425\u0435\u043B\u044C\u043C\u0438\u0440.
          \u041F\u0440\u0438\u0441\u0430\u0436\u0438\u0432\u0430\u0439\u0441\u044F,
          \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440 \u0431\u0443\u0434\u0435\u0442
          \u0434\u043E\u043B\u0433\u0438\u043C."
        emotion: 0
    - rid: 7997109378020278355
      type: {class: SayEvent, ns: , asm: Assembly-CSharp}
